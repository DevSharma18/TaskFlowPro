# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL & MongoDB)
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow_pro
MONGODB_URI=mongodb://localhost:27017/taskflow_pro

# Caching & Rate Limiting (Pluggable: memory | redis)
CACHE_DRIVER=memory
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-32-char-minimum-secret
JWT_REFRESH_SECRET=change-me-different-32-char-secret

# CORS
CLIENT_ORIGIN=http://localhost:5173

# AI (server-side only — never expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
